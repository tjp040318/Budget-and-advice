+/// A rectangle a plate draws, in overlay points (y up): the badge and the
+/// track, or the row of status tiles with their turn chips. `UnitPlate`
+/// gives its own from its centre; `placed(at:)` stands one on the frame.
+struct PlateBox {
+    var rect: CGRect
+    /// The status row's. Nothing may stand within four points of it across:
+    /// run 224's arena lifted a plate clear of its neighbour's badge alone,
+    /// and the lower plate's turn chip "2" stood on the lifted badge's ring
+    /// beside its "40" — "240".
+    var isTiles: Bool
+
+    func placed(at centre: CGPoint) -> PlateBox {
+        PlateBox(rect: rect.offsetBy(dx: centre.x, dy: centre.y), isTiles: isTiles)
+    }
+
+    /// Whether two placed boxes are near enough across to meet at some
+    /// height. A badge may graze the rounded end of the next track by three
+    /// points — or every row of five abreast would zigzag — but a tile row
+    /// keeps four clear of anything.
+    func isBeside(_ other: PlateBox) -> Bool {
+        let across = min(rect.maxX, other.rect.maxX) - max(rect.minX, other.rect.minX)
+        return across > (isTiles || other.isTiles ? -4 : 3)
+    }
+
+    /// Whether two placed boxes meet: beside each other, and overlapping up
+    /// and down — or, with a tile row in it, within two points.
+    func meets(_ other: PlateBox) -> Bool {
+        guard isBeside(other) else { return false }
+        let upright = min(rect.maxY, other.rect.maxY) - max(rect.minY, other.rect.minY)
+        return upright > (isTiles || other.isTiles ? -2 : 0)
+    }
+}
