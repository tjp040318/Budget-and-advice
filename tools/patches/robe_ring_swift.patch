+/// What the simulation steps: a cape's chain (`ClothChain`) or a robe's ring
+/// (`ClothRing`). Each keeps its own state and writes only its own joints.
+protocol ClothStepping: AnyObject {
+    /// Whether the figure the cloth belongs to is still alive.
+    var isAlive: Bool { get }
+    /// Advances the cloth to `time` and writes its joints' orientations.
+    func step(at time: TimeInterval)
+    /// Whether the cloth's figure hangs somewhere under `root`.
+    func stands(under root: SCNNode) -> Bool
+}
+
+/// Every live chain and ring, stepped from whichever render delegate is
+/// drawing the scene its figure stands in. They are dropped as their figures
+/// go. A figure with a cape AND a ring registers the chain first, so the
+/// chain steps first, as `tools/cape_sim.py`'s `play` runs CapeSim before
+/// RingSim; the two never touch each other's joints.
+final class ClothSimulation {
+    static let shared = ClothSimulation()
+    private let lock = NSLock()
+    private var chains: [ClothStepping] = []
+
+    private init() {}
+
+    func register(_ chain: ClothStepping) {
+        lock.lock()
+        chains.removeAll { !$0.isAlive }
+        chains.append(chain)
+        lock.unlock()
+    }
+
+    /// Steps the chains whose figures stand in `scene`. Call from
+    /// `renderer(_:didApplyAnimationsAtTime:)`: the anchors' presentation
+    /// transforms carry this frame's pose there, and what the chains set on
+    /// the model tree is drawn in the same frame.
+    func step(in scene: SCNScene?, at time: TimeInterval) {
+        guard let root = scene?.rootNode else { return }
+        lock.lock()
+        chains.removeAll { !$0.isAlive }
+        let live = chains
+        lock.unlock()
+        for chain in live where chain.stands(under: root) {
+            chain.step(at: time)
+        }
+    }
+}
+
+extension ClothChain: ClothStepping {
+    /// Whether the chain's anchor hangs somewhere under `root`.
+    func stands(under root: SCNNode) -> Bool {
+        var node: SCNNode? = anchor
+        while let current = node {
+            if current === root { return true }
+            node = current.parent
+        }
+        return false
+    }
+}
+
+/// A render delegate for a stage that has none of its own — the reveal and
+/// the island — whose one job is to step the cloth each frame. The view's
+/// `delegate` is weak, so the coordinator holds this.
+final class ClothStepper: NSObject, SCNSceneRendererDelegate {
+    func renderer(_ renderer: SCNSceneRenderer, didApplyAnimationsAtTime time: TimeInterval) {
+        ClothSimulation.shared.step(in: renderer.scene, at: time)
+    }
+}
