*.moved-aside

# xcodebuild logs from the terminal build in README.md
build.log

# macOS
.DS_Store

# API keys for tools/genart.py live outside the repo
*.key

# Python bytecode from the tools
__pycache__/

# Meshy clip exports: one 6–7 MB GLB per animation per character. The shipped
# clips are the small USDZ files in Pantheon/Resources/Models; the sources can
# be fetched again with `python3 tools/meshy.py download <asset>` while Meshy
# keeps them, and the base export beside them is what the pipeline reads.
Art/Models/*_idle_combat.glb
Art/Models/*_attack_basic.glb
Art/Models/*_attack_heavy.glb
Art/Models/*_hit_react.glb
Art/Models/*_death.glb
Art/Models/*_ultimate.glb
Art/Models/*_idle.glb
Art/Models/*_victory.glb
Art/Models/*_cast_loop.glb
Art/Models/*_cast_release.glb
Art/Models/*_summon_reveal.glb

# Meshy preview-stage exports: superseded by the refine stage beside them.
Art/Models/*_preview.usdz
Art/Models/*_preview.glb

# Meshy's per-clip raw exports: each is a full copy of the mesh and texture
# (6-7 MB) whose only unique content is one animation track. The base export
# and the manifest are committed; `python3 tools/meshy.py download <asset>`
# refetches the clip files when a family has to be reshipped.
Art/Models/*_idle_combat.glb
Art/Models/*_attack_basic.glb
Art/Models/*_attack_heavy.glb
Art/Models/*_hit_react.glb
Art/Models/*_death.glb
Art/Models/*_ultimate.glb
Art/Models/*_victory.glb
Art/Models/*_idle.glb
Art/Models/*_summon_reveal.glb
